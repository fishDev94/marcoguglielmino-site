{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "categories": {
    "style": "off",
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-implicit-coercion": "off",
    "no-ternary": "off",
    "sort-keys": "off",
    "id-length": "off",
    "prefer-template": "off",
    "capitalized-comments": "off",
    "max-statements": "off"
  },
  "ignorePatterns": [
    "node_modules",
    ".nuxt",
    ".output",
    "dist"
  ]
}
